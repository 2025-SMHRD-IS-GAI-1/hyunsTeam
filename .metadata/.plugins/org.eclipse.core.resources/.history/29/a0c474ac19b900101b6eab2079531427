<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SUPPHOTO - 회원가입 약관</title>
    <link rel="stylesheet" href="./assets/css/join.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
    <div class="join-box">
        <div class="join-wrap">
    
    <div class="join-container">
        <header class="header">
            <h1>회원가입</h1>
            <a href="Gologin.do">취소</a>
        </header>

        <section class="logo">
            <img class="join-img" src="./assets/img/join-img.png">
            <h1>SUPPHOTO</h1>
            <p>얼굴만 찍어,</p>
            <p>나머진 서포토가 해줄게</p>
        </section>

        <section class="join-agree">
            <h2><i class="fas fa-file-alt"></i> 서포토 서비스 이용약관</h2>
            <div class="join-agree-list">
                <label class="all-agree">
                    <input type="checkbox" id="all-agree-check" class="checkbox">
                    <span class="check-icon"><i class="fas fa-check-circle"></i></span>
                    모두 동의 (선택정보 포함)
                </label>

                <div class="divider"></div>

                <label class="label required">
                    <input type="checkbox" class="checkbox required">
                    <span class="check-icon"><i class="fas fa-check-circle"></i></span>
                    서비스 이용약관 동의 (필수)
                    <button type="button" class="view-btn">보기</button>
                </label>

                <label class="label required">
                    <input type="checkbox" class="checkbox required">
                    <span class="check-icon"><i class="fas fa-check-circle"></i></span>
                    개인정보 수집 및 이용 동의 (필수)
                    <button type="button" class="view-btn">보기</button>
                </label>

                <label class="label option">
                    <input type="checkbox" class="checkbox option">
                    <span class="check-icon"><i class="fas fa-check-circle"></i></span>
                    위치기반 서비스 이용약관 동의 (선택)
                    <button type="button" class="view-btn">보기</button>
                </label>
            </div>
        </section>
            <button type="button" class="next-btn" id="next-btn" disabled>다음<i
                    class="fas fa-chevron-right"></i></button>

    </div>
    <div class="join-container">
        <header class="header"  style="justify-content: flex-start;">
            <div class="back-btn">
                <i class="fas fa-chevron-left"></i>
            </div>
            <h1>회원가입 정보 입력</h1>
        </header>

        <section class="join-form">
            <form action="#">

                <!-- <div class="input-group">
                    <label for="user-id"><i class="fas fa-user"></i> 아이디</label>
                    <input type="text" id="user-id" placeholder="아이디를 입력해 주세요." required>
                </div> -->

                <div class="input-group email-group">
                    <label for="email"><i class="fas fa-envelope"></i> 이메일</label>
                    <div class="email-input-wrap">
                        <input type="email" id="email" name="email" placeholder="이메일을 입력해 주세요." required>
                        <button type="button" class="verify-email-btn">인증하기</button>
                    </div>
                </div>

                <div class="input-group password-main-group">
                    <label for="password"><i class="fas fa-lock"></i> 비밀번호</label>
                    <input type="password" id="password" placeholder="비밀번호 입력" required>
                    <button type="button" class="view-password-btn" data-target="password">비밀번호 표시</button>
                    <div class="feedback" id="password-feedback"></div>
                </div>

                <div class="input-group password-confirm-group">
                    <label for="password-confirm"><i class="fas fa-lock"></i> 비밀번호 확인</label>
                    <input type="password" id="password-confirm" placeholder="비밀번호를 다시 입력해 주세요." required>
                    <button type="button" class="view-password-btn" data-target="password-confirm">비밀번호 표시</button>
                    <div class="feedback" id="password-confirm-feedback"></div>
                </div>

                <div class="input-group phone-group">
                    <label for="phone-number"><i class="fas fa-mobile-alt"></i> 휴대폰 번호 인증</label>
                    <div class="phone-input-wrap">
                        <input type="text" id="phone-number" placeholder="휴대폰 번호 입력" required>
                        <button type="button" class="send-code-btn" id="send-code-btn">인증번호 전송</button>
                    </div>
                </div>

                <div class="input-group verification-code-group" id="verification-code-section">
                    <label for="verification-code"><i class="fas fa-key"></i> 인증번호</label>
                    <div class="code-input-wrap">
                        <input type="text" id="verification-code" placeholder="인증번호 6자리를 입력해 주세요." required>
                        <span class="timer" id="timer-display">05:00</span>
                        <button type="button" class="verify-code-btn" disabled>확인</button>
                    </div>
                </div>
            </form>
        </section>

        <footer class="join-submit">
            <button type="submit" class="submit-btn" disabled>회원가입</button>
        </footer>
    </div>
    </div>
    </div>
    <script src="./assets/js/join.js"></script>
</body>

</html>