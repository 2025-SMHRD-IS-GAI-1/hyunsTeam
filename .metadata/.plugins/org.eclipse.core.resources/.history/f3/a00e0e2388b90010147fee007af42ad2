document.addEventListener('DOMContentLoaded', () => {
    // 1. 필요한 DOM 요소 가져오기
    const allAgreeCheckbox = document.getElementById('all-agree-check');
    const requiredCheckboxes = document.querySelectorAll('.checkbox.required');
    const optionCheckboxes = document.querySelectorAll('.checkbox.option');
    const allCheckboxes = document.querySelectorAll('.join-agree-list .checkbox');
    const nextButton = document.getElementById('next-btn');
    const nextBtn = document.querySelector('.next-btn');
    const backBtn = document.querySelector('.back-btn');
    const joinWrap = document.querySelector('.join-wrap');
	
    nextBtn.addEventListener('click',()=>{
        joinWrap.style.transform = "translateX(-50%)";
    })
    backBtn.addEventListener('click',()=>{
        joinWrap.style.transform = "translateX(0%)";
    })
    // 2. '모두 동의' 체크박스 이벤트 리스너
    allAgreeCheckbox.addEventListener('change', function() {
        const isChecked = this.checked;
        
        // '모두 동의'가 체크되면 모든 체크박스를 체크/해제
        allCheckboxes.forEach(checkbox => {
            checkbox.checked = isChecked;
        });
        
        // 상태가 변경될 때마다 다음 버튼 상태 업데이트
        checkNextButtonStatus();
    });

    // 3. 개별 체크박스 이벤트 리스너 (필수, 선택 모두)
    allCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
            
            // 필수 약관이 모두 체크되었는지 확인
            checkNextButtonStatus();
            
            // 모든 체크박스의 상태를 확인하여 '모두 동의' 상태 업데이트
            let allChecked = true;
            allCheckboxes.forEach(cb => {
                if (!cb.checked) {
                    allChecked = false;
                }
            });
            allAgreeCheckbox.checked = allChecked;
        });
    });

    // 4. '다음' 버튼 활성화 상태 확인 함수
    function checkNextButtonStatus() {
        let requiredAllChecked = true;
        
        // 필수 약관만 검사
        requiredCheckboxes.forEach(checkbox => {
            if (!checkbox.checked) {
                requiredAllChecked = false;
            }
        });

        // 필수 약관이 모두 체크되었으면 '다음' 버튼 활성화
        if (requiredAllChecked) {
            nextButton.disabled = false;
            nextButton.style.backgroundColor = '#000';
        } else {
            nextButton.disabled = true;
            nextButton.style.backgroundColor = '#ccc'; // 비활성화 색상 (CSS와 통일)
        }
    }
    
    const verificationSection = document.getElementById('verification-code-section');
    
    const timerDisplay = document.getElementById('timer-display');
    const phoneNumberInput = document.getElementById('phone-number');
    const verificationCodeInput = document.getElementById('verification-code');
    

	

		
		
    let countdown;
    const initialTime = 180; // 3분 (180초) 설정

 

    // 초(Seconds)를 "MM:SS" 형식으로 변환하는 함수
    function formatTime(seconds) {
        const minutes = Math.floor(seconds / 60);
        const remainingSeconds = seconds % 60;
        return `${String(minutes).padStart(2, '0')}:${String(remainingSeconds).padStart(2, '0')}`;
    }

    // 타이머 시작 및 카운트다운 로직 (생략)
    function startTimer() {
        let timeLeft = initialTime;
        timerDisplay.textContent = formatTime(timeLeft);
        timerDisplay.style.color = '#f00'; 

        clearInterval(countdown); 

        countdown = setInterval(() => {
            timeLeft--;
            timerDisplay.textContent = formatTime(timeLeft);

            if (timeLeft <= 0) {
                clearInterval(countdown);
                timerDisplay.textContent = '00:00';
                timerDisplay.style.color = '#777'; 
                
                verificationCodeInput.value = '';
                verifyCodeBtn.disabled = true;
                verifyCodeBtn.style.backgroundColor = '#ccc';
                verifyCodeBtn.style.color = '#777';

                sendCodeBtn.textContent = '재전송'; 
                sendCodeBtn.disabled = false;
                
                alert('인증 시간이 만료되었습니다. 다시 전송해주세요.');
            }
        }, 1000); 
    }
    
   
	let phoneNumber = phoneNumberInput.value.trim();
	const sendCodeBtn = document.getElementById('send-code-btn');
	    // 3. '인증번호 전송' 버튼 클릭 이벤트 핸들러 (유지)
	    sendCodeBtn.addEventListener('click', () => {
	        
			const MobileDomestic = /^01(?:0|1|[6-9])[-\s]?(?:\d{3}|\d{4})[-\s]?\d{4}$/;
	        if (!MobileDomestic.test(phoneNumber)) {
	            alert('정확한 휴대폰 번호를 입력해주세요.');
	            phoneNumberInput.focus();
	            return;
	        }
			fetch('SendSms.do?phone=' + phoneNumber)
			.then(res=>res.json())
			.then(result=>{
				console.log(result)
				if(result == "success"){
					verificationSection.style.display = 'block';
						        startTimer();

						        verificationCodeInput.value = ''; 
						        verifyCodeBtn.disabled = true;
						        verifyCodeBtn.style.backgroundColor = '#ccc'; 
						        verifyCodeBtn.style.color = '#777';
						        
						        sendCodeBtn.disabled = true;
						        sendCodeBtn.textContent = '전송 중...'; 
						        
						        setTimeout(() => {
						            sendCodeBtn.textContent = '재전송';
						        }, 1000);
				}else{
					
					//window.location.href="Gofail.do"
				}
			})
	        
	    });
   
    // 4. 인증번호 입력 시 '확인' 버튼 활성화/비활성화 (유지)
    verificationCodeInput.addEventListener('input', () => {
        const codeLength = verificationCodeInput.value.trim().length;
        
        if (codeLength >= 6 && countdown) {
            verifyCodeBtn.disabled = false;
            verifyCodeBtn.style.backgroundColor = '#000'; 
            verifyCodeBtn.style.color = '#fff';
        } else {
            verifyCodeBtn.disabled = true;
            verifyCodeBtn.style.backgroundColor = '#ccc'; 
            verifyCodeBtn.style.color = '#777';
        }
    });
	
	const joinBtn = document.querySelector('.submit-btn');
	const verifyCodeBtn = document.querySelector('.verify-code-btn');
	const verifyMessage = document.getElementById('verify-Message');
	let isVaild = false;
	verifyCodeBtn.addEventListener('click',()=>{
		fetch(`VerifySms.do?phone=${phoneNumber}&code=${verifyCodeBtn.value.trim()}`)
		.then(res=>res.json())
		.then(result=>{
			console.log(result,"낧아왓냐?")
			if(result == "success"){
				isVaild=true;
				verifyMessage.style.coor = "green";
				verifyMessage.innerText = "인증되었습니다";
			}else{
				verifyMessage.style.coor = "red";
				verifyMessage.innerText = "인증번호가 일치하지 않습니다. 자세히 확인해주세요.";
			}
			if(isVaild){
				joinBtn.style.cursor ="pointer";
				joinBtn.style.backgroundColor ="#000";
			}
		})
	})

});