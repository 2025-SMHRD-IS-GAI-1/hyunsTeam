*{
	margin : 0;
	padding : 0;
}

body{
	display:flex;
	justify-content:center; 
	align-items: center;
	background : #3477eb;
}

p {
	font-size:20px;
}

#container{
	display:flex;
	justify-content:center; 
	align-items: center;
	max-width: 450px;
	width: 100%;
	height: 100vh;
	background : #fff;
}

.inner-wrap {
	display:flex;
	flex-direction : column;
	justify-content:center; 
	align-items:center;
	padding : 0 5%;
	max-height: 750px;
	height: 100%;
}

.start-btn {
	padding: 10px 20px;
	border: 1px #b9b9b9 solid;
	color: rgb(56, 56, 56);
	margin-top: 30px;
	font-size:20px;
	transition:.3s ease;
}

.start-btn:hover{
	color: #fff;
	background : #000;
	border: 1px #000 solid;
}



