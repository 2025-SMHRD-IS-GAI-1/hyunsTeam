*{
	margin : 0;
	padding : 0;
}

body{
	display:flex;
	justify-content:center; 
	align-items: center;
	padding: 5%;
	height: 90vh;
	background : #000040;
}

.inner-wrap {
	
	display:flex;
	flex-direction : column;
	justify-content:center; 
	align-items:center;
	max-height: 750px;
	height: 100%;
}

#container{
	display:flex;
	justify-content:center; 
	align-items: center;
	max-width: 370px;
	width: 100%;
	height: 100%;
	background : #fff;
}

.start-btn {
	padding: 10px 20px;
	border: 1px #b9b9b9 solid;
	color: rgb(56, 56, 56);
	margin-top: 30px;
}




