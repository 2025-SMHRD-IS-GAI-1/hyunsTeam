<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.supphoto.model.UserDAO">
  <select id="socialLogin" resultType="com.supphoto.model.UserVO">
    	SELECT USER_ID,NAME,PHONE_NUMBER,FIRST_JOIN FROM TB_USER WHERE USER_ID=#{id}
  </select>
  <select id="checkId" resultType="com.supphoto.model.UserVO">
    	SELECT USER_ID FROM TB_USER WHERE USER_ID=#{id}
  </select>
</mapper>